{
	"name": "pilo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:web": "nsh dev --target web web",
		"generate:icons": "node scripts/generate-desktop-icons.mjs",
		"generate:themes": "node scripts/generate-desktop-themes.mjs",
		"build": "tsc -p shared && node scripts/build-nsh-web.mjs",
		"build:web": "node scripts/build-nsh-web.mjs",
		"server:build": "node scripts/build-server.mjs",
		"server:build:win": "scripts\\build-pilo-server.cmd",
		"server:build:linux-x64": "bash scripts/build-pilo-server.sh linux-x86_64",
		"server:verify": "bash scripts/verify-pilo-server-resources.sh",
		"lint": "oxlint . --deny-warnings",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint && tsc -p shared",
		"hooks:install": "git config --local core.hooksPath .githooks",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:unit": "node --experimental-strip-types --import ./tests/helpers/tsx-loader.mjs --test \"tests/unit/**/*.spec.ts\" \"tests/unit/**/*.spec.mjs\"",
		"test:integration": "node --experimental-strip-types --import ./tests/helpers/tsx-loader.mjs --test \"tests/integration/**/*.spec.ts\" \"tests/integration/**/*.spec.mjs\""
	},
	"devDependencies": {
		"lucide-react": "^1.43.0",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"postcss": "8.5.28",
		"typescript": "~6.0.3"
	}
}
