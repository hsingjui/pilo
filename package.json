{
	"name": "pilo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm tauri dev --features webdriver",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"server:build": "bash scripts/build-pilo-server.sh",
		"server:build:win": "scripts\\build-pilo-server.cmd",
		"server:build:linux-x64": "bash scripts/build-pilo-server.sh linux-x86_64",
		"server:verify": "bash scripts/verify-pilo-server-resources.sh",
		"lint": "oxlint . --react-plugin --jsx-a11y-plugin --deny-warnings",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint",
		"test:unit": "node --experimental-strip-types --test tests/app-error.test.ts tests/chat-activity-state.test.ts tests/chat-file-suggestions.test.ts tests/chat-input-history.test.ts tests/chat-performance-switch.test.ts tests/chat-runtime-replay.test.ts tests/chat-runtime-trace.test.ts tests/chat-stream-presentation.test.ts tests/chat-streaming-markdown.test.ts tests/chat-history-window-store.test.ts tests/chat-conversation-store.test.ts tests/chat-submission.test.ts tests/conversation-reducer.test.ts tests/app-chat-state.test.ts tests/pi-model-selection.test.ts tests/pi-session-fork.test.ts tests/skill-invocation.test.ts tests/i18n-locale.test.ts"
	},
