{
	"name": "pilo",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"desktop:generate:icons": "node scripts/generate-desktop-icons.mjs",
		"desktop:generate:themes": "node scripts/generate-desktop-themes.mjs",
		"build": "tsc -p shared && tsc && vite build",
		"build:nsh-web": "node scripts/build-nsh-web.mjs",
		"dev:nsh-web": "nsh dev --target web desktop/mobile",
		"preview": "vite preview",
		"server:build": "node scripts/build-server.mjs",
		"server:build:win": "scripts\\build-pilo-server.cmd",
		"server:build:linux-x64": "bash scripts/build-pilo-server.sh linux-x86_64",
		"server:verify": "bash scripts/verify-pilo-server-resources.sh",
		"lint": "oxlint . --react-plugin --jsx-a11y-plugin --deny-warnings",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"check": "pnpm format:check && pnpm lint",
		"hooks:install": "git config --local core.hooksPath .githooks",
		"test": "pnpm test:unit && pnpm test:integration",
		"test:unit": "node --experimental-strip-types --import ./tests/helpers/tsx-loader.mjs --test \"tests/unit/**/*.test.ts\" \"tests/unit/**/*.test.mjs\"",
		"test:integration": "node --experimental-strip-types --import ./tests/helpers/tsx-loader.mjs --test \"tests/integration/**/*.test.ts\" \"tests/integration/**/*.test.mjs\""
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-hover-card": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@shikijs/langs": "4.1.0",
		"@streamdown/math": "^1.0.2",
		"@tanstack/react-virtual": "3.14.11",
		"bowser": "^2.14.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"highlight.js": "^11.12.0",
		"i18next": "^26.4.2",
		"katex": "^0.16.47",
		"lucide-react": "^1.43.0",
		"mermaid": "11.15.0",
		"qrcode.react": "^4.2.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-i18next": "^17.0.14",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"remend": "1.3.1",
		"shiki": "4.1.0",
		"sonner": "^2.0.8",
		"streamdown": "^2.6.0",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"unified": "^11.0.5",
		"virtua": "0.49.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"oxfmt": "^0.67.0",
		"oxlint": "^1.82.0",
		"postcss": "8.5.28",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.0.16",
		"vite-plugin-pwa": "^1.3.0"
	}
}
