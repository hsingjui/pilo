{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"types": [],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"paths": {
			"@shared/*": ["./*"]
		}
	},
	"include": ["**/*.ts", "**/*.json"]
}
