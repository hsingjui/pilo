{
	"name": "Pilo Dev",
	"id": "app.hsingjui.pilo.dev",
	"version": "0.5.2",
	"icon": {
		"macos": "app/assets/app-icon-macos.png",
		"windows": "app/assets/app-icon.png",
		"linux": "app/assets/app-icon.png"
	},
	"macos": {
		"infoPlist": {
			"NSLocalNetworkUsageDescription": "Pilo uses the local network to connect to SSH hosts and serve the Remote WebUI."
		}
	},
	"theme": "theme/theme.json",
	"singleInstance": true,
	"window": {
		"defaultPosition": "center",
		"restoreBounds": true,
		"defaultSize": {
			"width": 1200,
			"height": 800
		},
		"minSize": {
			"width": 768,
			"height": 600
		}
	},
	"build": 1,
	"capabilities": {
		"application": true,
		"clipboard": true,
		"picker": true,
		"notifications": true,
		"statusBar": true,
		"process": {
			"env": ["PILO_APPIMAGE"]
		},
		"network": {
			"http": [
				{
					"host": "api.github.com",
					"schemes": ["https"],
					"methods": ["GET"],
					"pathPrefix": "/repos/hsingjui/pilo/releases/tags/"
				}
			],
			"hosts": ["*"]
		},
		"openUrl": {
			"schemes": ["https", "zed", "vscode", "cursor"]
		}
	},
	"rust": "crates/pilo-desktop",
	"resolve": {
		"alias": {
			"@shared": "./shared"
		}
	}
}
