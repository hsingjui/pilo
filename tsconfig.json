{
	"extends": "./.nsh/tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"paths": {
			"nsh": ["./.nsh/types/nsh/index.d.ts"],
			"nsh/*": ["./.nsh/types/nsh/*.d.ts"],
			"app/*": ["./.nsh/types/app/*.d.ts"],
			"process": ["./.nsh/types/process.d.ts"],
			"@shared/*": ["./shared/*"]
		}
	},
	"include": [
		"App.tsx",
		"app/**/*.ts",
		"app/**/*.tsx",
		"web/**/*.ts",
		"web/**/*.tsx"
	],
	"exclude": ["target", "crates", "dist", "node_modules", "tests", "scripts"]
}
