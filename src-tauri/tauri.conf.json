{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pilo",
	"version": "0.1.0",
	"identifier": "app.hsingjui.pilo",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Pilo",
				"width": 900,
				"height": 670,
				"minWidth": 768,
				"minHeight": 600,
				"center": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": { "x": 20.0, "y": 25.0 }
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"resources/": "runtime/",
			"icons/128x128.png": "icons/128x128.png"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
