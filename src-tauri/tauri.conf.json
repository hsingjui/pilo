{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Pilo",
	"identifier": "app.hsingjui.pilo",
	"build": {
		"beforeDevCommand": "pnpm exec vite",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Pilo",
				"width": 900,
				"height": 670,
				"minWidth": 768,
				"minHeight": 600,
				"center": true,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": { "x": 20.0, "y": 25.0 }
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"createUpdaterArtifacts": true,
		"resources": {
			"resources/": "runtime/",
			"icons/128x128.png": "icons/128x128.png"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QTRGQjk4NDA5Q0Q5QTMKUldTajJaeEFtUHVrOU9XVDFzSXNuNzRLTE4rWDNPRVg1RkJJV2tFWnBGQy8yd0tEbUNFVGI4MjgK",
			"endpoints": [
				"https://github.com/hsingjui/pilo/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
