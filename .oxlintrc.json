{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"overrides": [
		{
			"files": ["shared/**"],
			"rules": {
				"no-restricted-imports": [
					"error",
					{
						"patterns": [
							{
								"group": [
									"nsh",
									"nsh/*",
									"app/*",
									"react",
									"react-*",
									"react/*"
								],
								"message": "shared/ is plain TypeScript shared across Desktop, Web, and Node tests."
							}
						]
					}
				]
			}
		}
	],
	"ignorePatterns": [
		".nsh/**",
		".pi/**",
		"App.tsx",
		"app/**",
		"crates/**",
		"dist/**",
		"target/**",
		"web/**"
	],
	"env": {
		"builtin": true,
		"browser": true
	}
}
