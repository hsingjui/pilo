{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	},
	"ignorePatterns": [".pi/**", "dist/**", "target/**"],
	"env": {
		"builtin": true,
		"browser": true
	}
}
