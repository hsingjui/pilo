{
	"name": "Pilo",
	"id": "app.hsingjui.pilo.web",
	"version": "0.5.2",
	"icon": "assets/pilo-512.png",
	"theme": "../theme/theme.json",
	"web": {
		"base": "/"
	},
	"capabilities": {
		"clipboard": true,
		"picker": true,
		"network": {
			"hosts": ["*"]
		},
		"openUrl": { "schemes": ["http", "https"] }
	},
	"resolve": {
		"alias": {
			"@shared": "../shared"
		}
	}
}
