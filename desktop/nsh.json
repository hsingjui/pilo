{
	"name": "Pilo",
	"id": "app.hsingjui.pilo",
	"version": "0.4.1",
	"icon": {
		"macos": "assets/app-icon-macos.png",
		"windows": "assets/app-icon.png",
		"linux": "assets/app-icon.png"
	},
	"macos": {
		"infoPlist": {
			"NSLocalNetworkUsageDescription": "Pilo uses the local network to connect to SSH hosts and serve the Remote WebUI."
		}
	},
	"theme": "theme.json",
	"singleInstance": true,
	"window": {
		"defaultPosition": "center",
		"restoreBounds": true,
		"defaultSize": {
			"width": 1200,
			"height": 800
		},
		"minSize": {
			"width": 768,
			"height": 600
		}
	},
	"build": 1,
	"capabilities": {
		"application": true,
		"clipboard": true,
		"picker": true,
		"notifications": true,
		"statusBar": true,
		"openUrl": { "schemes": ["https", "zed", "vscode", "cursor"] }
	},
	"rust": ".",
	"resolve": {
		"alias": {
			"@shared": "../shared"
		}
	}
}
