{
	"name": "Pilo",
	"id": "app.hsingjui.pilo.desktop",
	"version": "0.4.1",
	"icon": { "macos": "assets/app-icon-macos.png" },
	"theme": "theme.json",
	"singleInstance": true,
	"window": {
		"defaultPosition": "center",
		"restoreBounds": true,
		"defaultSize": {
			"width": 1200,
			"height": 800
		},
		"minSize": {
			"width": 768,
			"height": 600
		}
	},
	"build": 1,
	"capabilities": {
		"application": true,
		"clipboard": true,
		"picker": true,
		"notifications": true,
		"statusBar": true,
		"openUrl": { "schemes": ["https"] }
	},
	"rust": ".",
	"resolve": {
		"alias": {
			"@shared": "../shared"
		}
	}
}
