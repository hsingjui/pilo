{
	"name": "Pilo",
	"id": "app.hsingjui.pilo.desktop",
	"version": "0.4.1",
	"theme": "theme.json",
	"window": {
		"defaultSize": {
			"width": 1200,
			"height": 800
		},
		"minSize": {
			"width": 768,
			"height": 600
		}
	},
	"build": 1,
	"capabilities": {
		"application": true,
		"notifications": true,
		"openUrl": { "schemes": ["https"] }
	},
	"rust": "native",
	"resolve": {
		"alias": {
			"@": "../src"
		}
	}
}
